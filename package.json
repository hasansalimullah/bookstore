{
  "name": "arabic-bookstore-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "node --env-file=.env --experimental-strip-types scripts/migrate.ts",
    "seed": "node --env-file=.env --experimental-strip-types scripts/seed.ts",
    "worker": "node --env-file=.env --experimental-strip-types src/worker/index.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "leak-check": "node --env-file=.env --experimental-strip-types scripts/leak-check.ts",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "@opennextjs/cloudflare": "^1.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}